    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "wait-on": "^9.1.0"
  }
}
