<mxfile host="app.diagrams.net" agent="generate-inventory-movement-flow" version="22.1.0">
  <diagram id="inventory-movement-flow" name="Inventory Movement Workflow (L1 Hub)">
    <mxGraphModel grid="1" pageWidth="810" pageHeight="1310" math="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
