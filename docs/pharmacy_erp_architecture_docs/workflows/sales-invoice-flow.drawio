<mxfile host="app.diagrams.net" agent="generate-sales-invoice-flow" version="22.1.0">
  <diagram id="sales-invoice-flow" name="Sales Invoice Workflow">
    <mxGraphModel grid="1" pageWidth="1100" pageHeight="2826" math="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="3" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="235" y="60" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Create a new draft sales invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="132" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="5" value="Customer selected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="216" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="6" value="Customer active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="338" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="7" value="Prescription linked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="460" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="8" value="Prescription valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="582" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="9" value="Add or edit medicines and quantities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="704" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="10" value="Ready to finalise?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="788" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="11" value="At least one item?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="910" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="12" value="Credit sale without customer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1032" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="13" value="Allocate stock by earliest expiry first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="1154" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="14" value="Enough stock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1238" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="15" value="Expired batch and not allowed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1360" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="16" value="Set price from price list (cap at MRP if set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="1482" width="220" height="52" as="geometry"/></mxCell>
