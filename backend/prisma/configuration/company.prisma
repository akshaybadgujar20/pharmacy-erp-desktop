model Company {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  companyCode String @unique @map("company_code")
  companyName String @unique @map("company_name")
  displayName String @map("display_name")

  gstNumber         String? @unique @map("gst_number")
  panNumber         String? @map("pan_number")
  drugLicenseNumber String? @map("drug_license_number")

  email       String?
  phoneNumber String? @map("phone_number")
  website     String?
  logoPath    String? @map("logo_path")

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  state        String?
  country      String?
  pinCode      String? @map("pin_code")

  isDefault Boolean @default(true) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  branches              Branch[]
  financialYears        FinancialYear[]
  appSettings           AppSetting[]
  barcodeConfigurations BarcodeConfiguration[]
  printerConfigurations PrinterConfiguration[]
  sequenceGenerators    SequenceGenerator[]

  @@index([gstNumber])
  @@index([isActive])
}
