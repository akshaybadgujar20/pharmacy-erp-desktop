model Branch {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  companyId BigInt @map("company_id")

  branchCode  String @map("branch_code")
  branchName  String @map("branch_name")
  displayName String @map("display_name")

  gstNumber         String? @map("gst_number")
  drugLicenseNumber String? @map("drug_license_number")

  email       String?
  phoneNumber String? @map("phone_number")

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  state        String?
  country      String?
  pinCode      String? @map("pin_code")

  managerName String?   @map("manager_name")
  openingDate DateTime? @map("opening_date")

  isHeadOffice Boolean @default(false) @map("is_head_office")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  company               Company                @relation(fields: [companyId], references: [id])
  stockAdjustments      StockAdjustment[]
  appSettings           AppSetting[]
  barcodeConfigurations BarcodeConfiguration[]
  financialYears        FinancialYear[]
  printerConfigurations PrinterConfiguration[]
  sequenceGenerators    SequenceGenerator[]
  prescriptions         Prescription[]
  priceLists            PriceList[]
  goodsReceipts         GoodsReceipt[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseOrders        PurchaseOrder[]
  purchaseReturns       PurchaseReturn[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  stockMovements        StockMovement[]
  stockTakes            StockTake[]
  transfersSent         StockTransfer[]        @relation("SourceStockTransfers")
  transfersReceived     StockTransfer[]        @relation("DestinationStockTransfers")

  @@unique([companyId, branchCode])
  @@index([companyId])
  @@index([isActive])
  @@index([isHeadOffice])
  @@index([gstNumber])
}
