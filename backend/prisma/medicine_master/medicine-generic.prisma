model MedicineGeneric {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  genericCode String @unique @map("generic_code")
  genericName String @unique @map("generic_name")

  therapeuticClass     String? @map("therapeutic_class")
  pharmacologicalClass String? @map("pharmacological_class")

  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version BigInt @default(1)

  medicineSalts    MedicineSalt[]
  saltCompositions SaltComposition[]

  @@index([therapeuticClass])
  @@index([isActive])
}
