model MedicineGeneric {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  genericCode String @unique @map("generic_code")
  genericName String @unique @map("generic_name")

  therapeuticClass     String? @map("therapeutic_class")
  pharmacologicalClass String? @map("pharmacological_class")

  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  medicineSalts MedicineSalt[]

  @@index([therapeuticClass])
  @@index([isActive])
}
