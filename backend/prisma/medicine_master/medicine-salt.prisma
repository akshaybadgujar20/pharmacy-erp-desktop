model MedicineSalt {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  medicineId        BigInt @map("medicine_id")
  saltCompositionId BigInt @map("salt_composition_id")

  sequenceNo Int      @map("sequence_no")
  percentage Decimal?

  version Int @default(1)

  medicine          Medicine         @relation(fields: [medicineId], references: [id])
  saltComposition   SaltComposition  @relation(fields: [saltCompositionId], references: [id])
  medicineGeneric   MedicineGeneric? @relation(fields: [medicineGenericId], references: [id])
  medicineGenericId BigInt?

  @@unique([medicineId, saltCompositionId])
  @@index([medicineId])
  @@index([saltCompositionId])
}
