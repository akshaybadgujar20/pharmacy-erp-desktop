model MedicineCategory {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  parentCategoryId BigInt? @map("parent_category_id")

  categoryCode String @unique @map("category_code")
  categoryName String @unique @map("category_name")

  description String?

  displayOrder Int @default(0) @map("display_order")

  isActive Boolean @default(true) @map("is_active")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version BigInt @default(1)

  parentCategory  MedicineCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories MedicineCategory[] @relation("CategoryHierarchy")

  medicines     Medicine[]
  discountRules DiscountRule[]

  @@index([parentCategoryId])
  @@index([displayOrder])
  @@index([isActive])
}
