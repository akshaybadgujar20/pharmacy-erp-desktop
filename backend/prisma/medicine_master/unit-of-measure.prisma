model UnitOfMeasure {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  unitCode  String @unique @map("unit_code")
  unitName  String @unique @map("unit_name")
  shortName String @map("short_name")

  unitType String @map("unit_type")

  decimalAllowed Boolean @default(false) @map("decimal_allowed")

  description String?

  isSystemUnit Boolean @default(false) @map("is_system_unit")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  medicines        Medicine[]
  saltCompositions SaltComposition[]

  @@index([unitType])
  @@index([isActive])
}
