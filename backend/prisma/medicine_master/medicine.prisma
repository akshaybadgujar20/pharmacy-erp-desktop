model Medicine {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  medicineCode String @unique @map("medicine_code")
  medicineName String @map("medicine_name")

  manufacturerId BigInt  @map("manufacturer_id")
  categoryId     BigInt  @map("category_id")
  scheduleId     BigInt? @map("schedule_id")
  unitId         BigInt  @map("unit_id")

  brandName  String? @map("brand_name")
  strength   String?
  dosageForm String  @map("dosage_form")
  packSize   String? @map("pack_size")

  hsnCode String? @map("hsn_code")
  barcode String?

  requiresPrescription Boolean @default(false) @map("requires_prescription")
  narcoticDrug         Boolean @default(false) @map("narcotic_drug")
  refrigerated         Boolean @default(false)

  discontinued Boolean @default(false)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  manufacturer Manufacturer      @relation(fields: [manufacturerId], references: [id])
  category     MedicineCategory  @relation(fields: [categoryId], references: [id])
  schedule     MedicineSchedule? @relation(fields: [scheduleId], references: [id])
  unit         UnitOfMeasure     @relation(fields: [unitId], references: [id])

  medicineSalts        MedicineSalt[]
  batches              Batch[]
  stockMovements       StockMovement[]
  prescriptionItems    PrescriptionItem[]
  discountRules        DiscountRule[]
  priceListItems       PriceListItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]

  @@index([medicineName])
  @@index([manufacturerId])
  @@index([categoryId])
  @@index([barcode])
  @@index([isActive])
}
