model LoyaltyProgram {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  programCode String @unique @map("program_code")
  programName String @unique @map("program_name")

  description String?

  pointsPerAmount Decimal @map("points_per_amount")
  redemptionValue Decimal @map("redemption_value")

  minimumRedemptionPoints Int  @map("minimum_redemption_points")
  maximumRedemptionPoints Int? @map("maximum_redemption_points")

  effectiveFrom BigInt  @map("effective_from")
  effectiveTo   BigInt? @map("effective_to")

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version Int @default(1)

  transactions LoyaltyTransaction[]

  @@index([isActive])
  @@index([isDefault])
  @@index([effectiveFrom, effectiveTo])
}
