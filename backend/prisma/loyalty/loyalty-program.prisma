model LoyaltyProgram {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  programCode String @unique @map("program_code")
  programName String @unique @map("program_name")

  description String?

  pointsPerAmount Decimal @map("points_per_amount")
  redemptionValue Decimal @map("redemption_value")

  minimumRedemptionPoints Int  @map("minimum_redemption_points")
  maximumRedemptionPoints Int? @map("maximum_redemption_points")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  transactions LoyaltyTransaction[]

  @@index([isActive])
  @@index([isDefault])
  @@index([effectiveFrom, effectiveTo])
}
