model Tax {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  taxCode String @unique @map("tax_code")
  taxName String @map("tax_name")

  taxType String  @map("tax_type")
  taxRate Decimal @map("tax_rate")

  effectiveFrom BigInt  @map("effective_from")
  effectiveTo   BigInt? @map("effective_to")

  isActive Boolean @default(true) @map("is_active")

  description String?

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version Int @default(1)

  priceListItems       PriceListItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  salesInvoiceItems    SalesInvoiceItem[]

  @@index([taxType])
  @@index([taxRate])
  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
}
