model User {
  id BigInt @id @default(autoincrement())

  employeeId BigInt @unique @map("employee_id")

  uuid String @unique @default(uuid())

  username     String @unique
  passwordHash String @map("password_hash")

  passwordChangedAt BigInt? @map("password_changed_at")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         BigInt? @map("locked_until")
  lastLoginAt         BigInt? @map("last_login_at")

  isActive           Boolean @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version BigInt @default(1)

  employee Employee @relation(fields: [employeeId], references: [id])

  userSessions UserSession[]
  userBranches UserBranch[]
  auditLogs    AuditLog[]

  partiesUpdated          Party[]           @relation("PartyUpdatedBy")
  partiesDeleted          Party[]           @relation("PartyDeletedBy")
  customersUpdated        Customer[]        @relation("CustomerUpdatedBy")
  customersDeleted        Customer[]        @relation("CustomerDeletedBy")
  suppliersUpdated        Supplier[]        @relation("SupplierUpdatedBy")
  suppliersDeleted        Supplier[]        @relation("SupplierDeletedBy")
  medicinesUpdated        Medicine[]        @relation("MedicineUpdatedBy")
  medicinesDeleted        Medicine[]        @relation("MedicineDeletedBy")
  batchesUpdated          Batch[]           @relation("BatchUpdatedBy")
  batchesDeleted          Batch[]           @relation("BatchDeletedBy")
  stockMovementsCreated   StockMovement[]   @relation("StockMovementCreatedBy")
  stockAdjustmentsCreated StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  stockTransfersCreated   StockTransfer[]   @relation("StockTransferCreatedBy")
  salesInvoicesCreated    SalesInvoice[]    @relation("SalesInvoiceCreatedBy")
  salesPaymentsCreated    SalesPayment[]    @relation("SalesPaymentCreatedBy")
  paymentsCreated         Payment[]         @relation("PaymentCreatedBy")
  receiptsCreated         Receipt[]         @relation("ReceiptCreatedBy")
  ledgerEntriesCreated    LedgerEntry[]     @relation("LedgerEntryCreatedBy")
  expensesCreated         Expense[]         @relation("ExpenseCreatedBy")

  @@index([isActive])
  @@index([lastLoginAt])
  @@index([lockedUntil])
}
