model UserSession {
  id BigInt @id @default(autoincrement())

  userId BigInt @map("user_id")

  companyId BigInt @map("company_id")
  branchId  BigInt @map("branch_id")

  uuid String @unique @default(uuid())

  sessionToken String  @unique @map("session_token")
  refreshToken String? @unique @map("refresh_token")

  deviceName         String? @map("device_name")
  deviceType         String? @map("device_type")
  operatingSystem    String? @map("operating_system")
  applicationVersion String? @map("application_version")

  ipAddress String? @map("ip_address")

  loginTime      BigInt  @map("login_time")
  lastActivityAt BigInt  @map("last_activity_at")
  logoutTime     BigInt? @map("logout_time")
  expiresAt      BigInt  @map("expires_at")

  isActive     Boolean @default(true) @map("is_active")
  logoutReason String? @map("logout_reason")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version Int @default(1)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@index([isActive])
  @@index([loginTime])
  @@index([expiresAt])
}
