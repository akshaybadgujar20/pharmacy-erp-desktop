model Payment {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  paymentNumber String @unique @map("payment_number")

  paymentType String @map("payment_type")
  paymentDate BigInt @map("payment_date")

  amount Decimal @map("amount")

  paymentMethod String @map("payment_method")

  transactionReference String? @map("transaction_reference")

  referenceType String? @map("reference_type")
  referenceId   BigInt? @map("reference_id")

  status String

  remarks String?

  createdBy BigInt? @map("created_by")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version Int @default(1)

  createdByUser User? @relation("PaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([paymentDate])
  @@index([paymentType])
  @@index([paymentMethod])
  @@index([status])
  @@index([referenceType, referenceId])
}
