model Receipt {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  receiptNumber String @unique @map("receipt_number")

  receiptType String   @map("receipt_type")
  receiptDate DateTime @map("receipt_date")

  amount Decimal @map("amount")

  receiptMethod String @map("receipt_method")

  transactionReference String? @map("transaction_reference")

  referenceType String? @map("reference_type")
  referenceId   BigInt? @map("reference_id")

  status String

  remarks String?

  createdBy BigInt? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  createdByUser User? @relation("ReceiptCreatedBy", fields: [createdBy], references: [id])

  @@index([receiptDate])
  @@index([receiptType])
  @@index([receiptMethod])
  @@index([status])
  @@index([referenceType, referenceId])
}
