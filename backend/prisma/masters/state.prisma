model State {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  countryId BigInt @map("country_id")

  stateCode String @map("state_code")
  stateName String @map("state_name")

  gstStateCode String? @map("gst_state_code")
  isoCode      String? @map("iso_code")

  isActive Boolean @default(true) @map("is_active")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version BigInt @default(1)

  country Country @relation(fields: [countryId], references: [id])

  cities City[]

  @@unique([countryId, stateCode])
  @@unique([countryId, stateName])
  @@index([countryId])
  @@index([isActive])
}
