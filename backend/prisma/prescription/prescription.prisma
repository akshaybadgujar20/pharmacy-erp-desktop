model Prescription {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid())

  prescriptionNumber String @unique @map("prescription_number")

  customerId BigInt @map("customer_id")
  doctorId   BigInt @map("doctor_id")
  branchId   BigInt @map("branch_id")

  prescriptionDate DateTime  @map("prescription_date")
  validUntil       DateTime? @map("valid_until")

  diagnosis String?
  symptoms  String?

  visitNumber String? @map("visit_number")

  status String

  remarks String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  customer Customer @relation(fields: [customerId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  items         PrescriptionItem[]
  salesInvoices SalesInvoice[]

  @@index([customerId])
  @@index([doctorId])
  @@index([branchId])
  @@index([prescriptionDate])
  @@index([status])
}
