model SalesInvoice {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  invoiceNumber String @map("invoice_number")

  customerId     BigInt? @map("customer_id")
  prescriptionId BigInt? @map("prescription_id")
  branchId       BigInt  @map("branch_id")

  invoiceDate DateTime @default(now()) @map("invoice_date")

  patientName String? @map("patient_name")
  doctorName  String? @map("doctor_name")

  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  roundOffAmount Decimal @default(0) @map("round_off_amount")
  netAmount      Decimal @map("net_amount")

  paidAmount    Decimal @default(0) @map("paid_amount")
  balanceAmount Decimal @default(0) @map("balance_amount")

  // paymentMode: CASH, UPI, CARD, CREDIT, SPLIT, CHEQUE, WALLET
  paymentMode   String? @map("payment_mode")
  // paymentStatus: PAID, PARTIALLY_PAID, UNPAID, REFUNDED
  paymentStatus String  @default("PAID") @map("payment_status")
  // status: DRAFT, POSTED, PARTIALLY_RETURNED, RETURNED, CANCELLED
  status        String  @default("POSTED") @map("status")

  // salesType: RETAIL_OTC, PRESCRIPTION, IPD_INPATIENT, OPD_OUTPATIENT, HOME_DELIVERY
  salesType String @default("RETAIL_OTC") @map("sales_type")

  remarks String? @map("remarks")

  createdBy BigInt? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  customer      Customer?     @relation(fields: [customerId], references: [id])
  prescription  Prescription? @relation(fields: [prescriptionId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  createdByUser User?         @relation("SalesInvoiceCreatedBy", fields: [createdBy], references: [id])

  items               SalesInvoiceItem[]
  payments            SalesPayment[]
  salesReturns        SalesReturn[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([branchId, invoiceNumber])
  @@index([customerId])
  @@index([prescriptionId])
  @@index([branchId])
  @@index([branchId, invoiceDate])
  @@index([customerId, invoiceDate])
  @@index([invoiceDate])
  @@index([status])
  @@index([paymentStatus])
  @@map("sales_invoices")
}
