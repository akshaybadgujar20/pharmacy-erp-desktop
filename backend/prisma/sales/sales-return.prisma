model SalesReturn {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  salesReturnNumber String @map("sales_return_number")

  salesInvoiceId BigInt  @map("sales_invoice_id")
  customerId     BigInt? @map("customer_id")
  branchId       BigInt  @map("branch_id")

  returnDate DateTime @default(now()) @map("return_date")

  // returnReason: COURSE_CHANGED, PATIENT_DISCHARGED, WRONG_MEDICINE, EXPIRED_ON_PURCHASE, DAMAGED_PACKAGING, EXCESS_QUANTITY, ADVERSE_REACTION, OTHER
  returnReason String @map("return_reason")

  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  roundOffAmount Decimal @default(0) @map("round_off_amount")
  netAmount      Decimal @map("net_amount")

  refundAmount     Decimal @default(0) @map("refund_amount")
  // refundMode: CASH, UPI, CARD_REVERSAL, STORE_CREDIT, BANK_TRANSFER
  refundMode       String? @map("refund_mode")
  creditNoteNumber String? @map("credit_note_number")

  // status: DRAFT, APPROVED, COMPLETED, CANCELLED
  status String @default("COMPLETED") @map("status")

  remarks String? @map("remarks")

  approvedByEmployeeId BigInt?   @map("approved_by_employee_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  approvedBy   Employee?    @relation(fields: [approvedByEmployeeId], references: [id])

  items SalesReturnItem[]

  @@unique([branchId, salesReturnNumber])
  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([returnDate])
  @@index([status])
  @@map("sales_returns")
}
