model SalesPayment {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  paymentNumber String @map("payment_number")

  salesInvoiceId BigInt @map("sales_invoice_id")
  branchId       BigInt @map("branch_id")

  paymentDate DateTime @default(now()) @map("payment_date")

  // paymentMethod: CASH, UPI, CREDIT_CARD, DEBIT_CARD, CHEQUE, STORE_CREDIT, NET_BANKING
  paymentMethod String  @map("payment_method")
  paymentAmount Decimal @map("payment_amount")

  tenderedAmount Decimal? @map("tendered_amount")
  changeReturned Decimal? @default(0) @map("change_returned")

  transactionReference String? @map("transaction_reference")
  cardLast4Digits      String? @map("card_last_4_digits")
  cardType             String? @map("card_type")
  posTerminalId        String? @map("pos_terminal_id")

  bankName     String?   @map("bank_name")
  chequeNumber String?   @map("cheque_number")
  chequeDate   DateTime? @map("cheque_date")

  // status: COMPLETED, PENDING, FAILED, BOUNCED, REFUNDED
  status String @default("COMPLETED") @map("status")

  remarks String? @map("remarks")

  createdBy BigInt? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  salesInvoice  SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  branch        Branch       @relation(fields: [branchId], references: [id])
  createdByUser User?        @relation("SalesPaymentCreatedBy", fields: [createdBy], references: [id])

  @@unique([branchId, paymentNumber])
  @@index([salesInvoiceId])
  @@index([branchId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([status])
  @@map("sales_payments")
}
