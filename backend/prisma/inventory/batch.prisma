model Batch {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  medicineId            BigInt  @map("medicine_id")
  purchaseInvoiceItemId BigInt? @map("purchase_invoice_item_id")

  batchNumber String @map("batch_number")

  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime  @map("expiry_date")

  purchaseRate Decimal @map("purchase_rate")
  mrp          Decimal
  saleRate     Decimal @map("sale_rate")

  discountPercent Decimal? @map("discount_percent")

  barcode String?

  isExpired Boolean @default(false) @map("is_expired")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  medicine            Medicine             @relation(fields: [medicineId], references: [id])
  purchaseInvoiceItem PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id])

  stock          Stock?
  stockMovements StockMovement[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([barcode])
  @@index([isExpired])
  @@index([isActive])
}
