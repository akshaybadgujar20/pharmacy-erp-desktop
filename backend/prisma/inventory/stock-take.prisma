model StockTake {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  stockTakeNumber String @map("stock_take_number")

  branchId BigInt @map("branch_id")

  stockTakeDate DateTime @map("stock_take_date")

  // countType: FULL_AUDIT, CYCLE_COUNT, SCHEDULE_H_AUDIT, COLD_CHAIN_AUDIT, NEAR_EXPIRY_AUDIT
  countType String @default("CYCLE_COUNT") @map("count_type")
  // status: DRAFT, IN_PROGRESS, COUNTED, RECONCILED, CANCELLED
  status    String @default("DRAFT") @map("status")

  countedByEmployeeId  BigInt    @map("counted_by_employee_id")
  approvedByEmployeeId BigInt?   @map("approved_by_employee_id")
  approvedAt           DateTime? @map("approved_at")

  remarks String? @map("remarks")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  branch     Branch    @relation(fields: [branchId], references: [id])
  countedBy  Employee  @relation("CountedStockTakes", fields: [countedByEmployeeId], references: [id])
  approvedBy Employee? @relation("ApprovedStockTakes", fields: [approvedByEmployeeId], references: [id])

  items StockTakeItem[]

  @@unique([branchId, stockTakeNumber])
  @@index([branchId])
  @@index([stockTakeDate])
  @@index([status])
  @@index([countType])
  @@map("stock_takes")
}
