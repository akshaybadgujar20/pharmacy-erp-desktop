model Employee {
  id      BigInt @id @default(autoincrement())
  partyId BigInt @unique @map("party_id")

  uuid String @unique @default(uuid())

  employeeCode String @unique @map("employee_code")

  designation String?
  department  String?

  joiningDate DateTime? @map("joining_date")
  leavingDate DateTime? @map("leaving_date")

  salary Decimal?

  licenseNumber String? @map("license_number")

  isPharmacist Boolean @default(false) @map("is_pharmacist")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  // Core Relations
  party            Party             @relation(fields: [partyId], references: [id])
  users            User[]
  stockAdjustments StockAdjustment[]
  stockTransfers   StockTransfer[]
  goodsReceipts    GoodsReceipt[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  salesReturns     SalesReturn[]

  // ✅ Disambiguated Named Relations for StockTakes
  countedStockTakes      StockTake[]    @relation("CountedStockTakes")
  approvedStockTakes     StockTake[]    @relation("ApprovedStockTakes")
  receivedGoodsReceipts  GoodsReceipt[] @relation("ReceivedGoodsReceipts")
  inspectedGoodsReceipts GoodsReceipt[] @relation("InspectedGoodsReceipts")

  @@index([department])
  @@index([designation])
  @@index([isPharmacist])
  @@index([isActive])
  @@map("employees")
}
