model GoodsReceipt {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  goodsReceiptNumber String @map("goods_receipt_number")

  purchaseOrderId BigInt? @map("purchase_order_id")
  supplierId      BigInt  @map("supplier_id")
  branchId        BigInt  @map("branch_id")

  receiptDate BigInt @map("receipt_date")

  supplierChallanNo   String?   @map("supplier_challan_no")
  supplierChallanDate BigInt? @map("supplier_challan_date")
  supplierInvoiceNo   String?   @map("supplier_invoice_no")
  supplierInvoiceDate BigInt? @map("supplier_invoice_date")
  vehicleNumber       String?   @map("vehicle_number")

  temperatureRecorded   Decimal? @map("temperature_recorded")
  isColdChainMaintained Boolean  @default(true) @map("is_cold_chain_maintained")

  // status: DRAFT, UNDER_INSPECTION, ACCEPTED, PARTIALLY_ACCEPTED, REJECTED, CANCELLED
  status String @default("DRAFT") @map("status")

  isBilled Boolean @default(false) @map("is_billed")

  remarks String? @map("remarks")

  receivedByEmployeeId  BigInt    @map("received_by_employee_id")
  inspectedByEmployeeId BigInt?   @map("inspected_by_employee_id")
  inspectedAt           BigInt? @map("inspected_at")

  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")

  version Int @default(1)

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  receivedBy    Employee       @relation("ReceivedGoodsReceipts", fields: [receivedByEmployeeId], references: [id])
  inspectedBy   Employee?      @relation("InspectedGoodsReceipts", fields: [inspectedByEmployeeId], references: [id])

  items            GoodsReceiptItem[]
  employee         Employee?          @relation(fields: [employeeId], references: [id])
  employeeId       BigInt?
  purchaseInvoices PurchaseInvoice[]

  @@unique([branchId, goodsReceiptNumber])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([branchId])
  @@index([receiptDate])
  @@index([status])
  @@index([isBilled])
  @@map("goods_receipts")
}
