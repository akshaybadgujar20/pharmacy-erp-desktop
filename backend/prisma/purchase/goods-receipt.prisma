model GoodsReceipt {
  id BigInt @id @default(autoincrement())

  uuid String @unique

  goodsReceiptNumber String @unique @map("goods_receipt_number")

  purchaseOrderId BigInt? @map("purchase_order_id")
  supplierId      BigInt  @map("supplier_id")
  branchId        BigInt  @map("branch_id")

  receiptDate DateTime @map("receipt_date")

  supplierChallanNo String? @map("supplier_challan_no")
  vehicleNumber     String? @map("vehicle_number")

  status String

  remarks String?

  receivedByEmployeeId BigInt @map("received_by_employee_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  receivedBy    Employee       @relation(fields: [receivedByEmployeeId], references: [id])

  items GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([branchId])
  @@index([receiptDate])
  @@index([status])
}
