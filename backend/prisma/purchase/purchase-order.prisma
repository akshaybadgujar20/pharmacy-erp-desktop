model PurchaseOrder {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseOrderNumber String @map("purchase_order_number")

  supplierId BigInt @map("supplier_id")
  branchId   BigInt @map("branch_id")

  orderDate            DateTime  @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")

  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  netAmount      Decimal @map("net_amount")

  // status: DRAFT, PENDING_APPROVAL, APPROVED, SENT_TO_SUPPLIER, PARTIALLY_RECEIVED, COMPLETED, FORCE_CLOSED, CANCELLED
  status String @default("DRAFT") @map("status")

  remarks String? @map("remarks")

  approvedByEmployeeId BigInt?   @map("approved_by_employee_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  approvedBy Employee? @relation(fields: [approvedByEmployeeId], references: [id])

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([branchId, purchaseOrderNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([orderDate])
  @@index([status])
  @@map("purchase_orders")
}
