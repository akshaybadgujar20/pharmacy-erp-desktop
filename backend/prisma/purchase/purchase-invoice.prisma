model PurchaseInvoice {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseInvoiceNumber String @map("purchase_invoice_number")
  supplierInvoiceNumber String @map("supplier_invoice_number")

  supplierId     BigInt  @map("supplier_id")
  goodsReceiptId BigInt? @map("goods_receipt_id")
  branchId       BigInt  @map("branch_id")

  invoiceDate DateTime  @map("invoice_date")
  dueDate     DateTime? @map("due_date")

  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  roundOffAmount Decimal @default(0) @map("round_off_amount")

  netAmount     Decimal @map("net_amount")
  paidAmount    Decimal @default(0) @map("paid_amount")
  balanceAmount Decimal @default(0) @map("balance_amount")

  // status: DRAFT, POSTED, CANCELLED
  status        String @default("DRAFT") @map("status")
  // paymentStatus: UNPAID, PARTIALLY_PAID, PAID, OVERDUE
  paymentStatus String @default("UNPAID") @map("payment_status")

  remarks String? @map("remarks")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  goodsReceipt    GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id])
  branch          Branch                @relation(fields: [branchId], references: [id])
  items           PurchaseInvoiceItem[]
  purchaseReturns PurchaseReturn[]

  @@unique([branchId, purchaseInvoiceNumber])
  @@unique([supplierId, supplierInvoiceNumber])
  @@index([supplierId])
  @@index([goodsReceiptId])
  @@index([branchId])
  @@index([branchId, invoiceDate])
  @@index([supplierId, invoiceDate])
  @@index([invoiceDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
  @@map("purchase_invoices")
}
