model PurchaseReturn {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseReturnNumber String @map("purchase_return_number")

  supplierId        BigInt  @map("supplier_id")
  purchaseInvoiceId BigInt? @map("purchase_invoice_id")
  branchId          BigInt  @map("branch_id")

  returnDate DateTime @map("return_date")

  // returnType: EXPIRED_GOODS, DAMAGED_GOODS, BATCH_RECALL, WRONG_ITEM_DELIVERED, NEAR_EXPIRY, EXCESS_STOCK
  returnType   String  @map("return_type")
  // status: DRAFT, PENDING_APPROVAL, DISPATCHED_TO_SUPPLIER, ACCEPTED, CREDITED, REJECTED, CANCELLED
  status       String  @default("DRAFT") @map("status")
  returnReason String? @map("return_reason")

  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  netAmount      Decimal @map("net_amount")

  supplierCreditNoteNo   String?   @map("supplier_credit_note_no")
  supplierCreditNoteDate DateTime? @map("supplier_credit_note_date")
  isSettled              Boolean   @default(false) @map("is_settled")

  remarks String? @map("remarks")

  approvedByEmployeeId BigInt?   @map("approved_by_employee_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  approvedBy      Employee?        @relation(fields: [approvedByEmployeeId], references: [id])

  items PurchaseReturnItem[]

  @@unique([branchId, purchaseReturnNumber])
  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@index([branchId])
  @@index([returnDate])
  @@index([status])
  @@index([returnType])
  @@index([isSettled])
  @@map("purchase_returns")
}
