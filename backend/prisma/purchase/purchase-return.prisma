// 1. Reason / Type of Purchase Return to Distributor
enum PurchaseReturnType {
  EXPIRED_GOODS // Expired stock return for distributor credit
  DAMAGED_GOODS // Broken, leaking, or damaged packaging
  BATCH_RECALL // Official manufacturer / drug authority recall
  WRONG_ITEM_DELIVERED // Discrepancy with original PO
  NEAR_EXPIRY // Return of stock with short remaining shelf-life
  EXCESS_STOCK // Overstocked goods returned by mutual agreement
}

// 2. Purchase Return / Debit Note Lifecycle Status
enum PurchaseReturnStatus {
  DRAFT // Return debit note drafted
  PENDING_APPROVAL // Awaiting manager / head pharmacist sign-off
  DISPATCHED_TO_SUPPLIER // Box handed over to distributor runner / courier
  ACCEPTED // Distributor acknowledged and accepted physical return
  CREDITED // Supplier Credit Note received & settled against accounts payable
  REJECTED // Return rejected by distributor (e.g., past claim window)
  CANCELLED // Voucher voided
}

model PurchaseReturn {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseReturnNumber String @unique @map("purchase_return_number") // Debit Note Number

  supplierId        BigInt  @map("supplier_id")
  purchaseInvoiceId BigInt? @map("purchase_invoice_id") // Optional link to original invoice
  branchId          BigInt  @map("branch_id")

  returnDate DateTime @map("return_date")

  // ✅ Enums Applied Here
  returnType   PurchaseReturnType   @map("return_type")
  status       PurchaseReturnStatus @default(DRAFT) @map("status")
  returnReason String?              @map("return_reason")

  // Financial Breakdown (GST Debit Note values)
  grossAmount    Decimal @map("gross_amount")
  discountAmount Decimal @default(0) @map("discount_amount")
  taxAmount      Decimal @default(0) @map("tax_amount")
  netAmount      Decimal @map("net_amount")

  // Supplier Settlement (Distributor Credit Note)
  supplierCreditNoteNo   String?   @map("supplier_credit_note_no")
  supplierCreditNoteDate DateTime? @map("supplier_credit_note_date")
  isSettled              Boolean   @default(false) @map("is_settled")

  remarks String? @map("remarks")

  approvedByEmployeeId BigInt?   @map("approved_by_employee_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  version Int @default(1)

  // Relations
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  approvedBy      Employee?        @relation(fields: [approvedByEmployeeId], references: [id])

  items PurchaseReturnItem[]

  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@index([branchId])
  @@index([returnDate])
  @@index([status])
  @@index([returnType])
  @@index([isSettled])
  @@map("purchase_returns")
}
