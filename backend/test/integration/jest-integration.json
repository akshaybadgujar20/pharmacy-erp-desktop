{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "roots": ["<rootDir>/test/integration"],
  "testEnvironment": "node",
  "testRegex": "integration\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^otplib$": "<rootDir>/test/setup/otplib.mock.ts"
  },
  "setupFiles": ["<rootDir>/test/setup/test-env.setup.ts"],
  "forceExit": true
}
